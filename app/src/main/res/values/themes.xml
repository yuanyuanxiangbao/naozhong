<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TaskAlarm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.TaskAlarm.Ring" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/ring_bg</item>
        <item name="android:statusBarColor">@color/ring_bg</item>
        <item name="android:navigationBarColor">@color/ring_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CardBg">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
